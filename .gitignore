# Maven
target/

# Node
node_modules/
*.log

# El front compilado: lo genera `npm run build` y va a los recursos del backend.
# No se versiona — se rehace, y versionarlo garantiza conflictos en cada rama.
backend/src/main/resources/front/

# El jar de despliegue: lo arma `./construir` y pesa 1,3 MB. Es un artefacto, no fuente.
cero-sitio.jar

# El paquete que baja el instalador: lo arma `./cero paquete` en el repo del framework.
# Medio mega de fuente comprimida no se versiona; se regenera.
backend/src/main/resources/instalador/cero-*.tar.gz
backend/src/main/resources/instalador/cero-*.tar.gz.sha256

# Credenciales, por si algún día este sitio necesita entrar con Google como hace
# cero-web. Va antes de que haga falta: un secreto solo se filtra una vez.
client_secret*.json
*.pem
*.key
.env
.env.*
