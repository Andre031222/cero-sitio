<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.ginit.corvoweb</groupId>
    <artifactId>corvo-sitio</artifactId>
    <version>0.1.0</version>
    <name>corvo-sitio</name>
    <description>El sitio de Corvo, servido por el propio Corvo</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <corvo.version>0.4.0</corvo.version>
    </properties>

    <dependencies>
        <!-- El sitio de Corvo corre sobre Corvo. Si algo del framework falla, falla aquí
             antes que en las aplicaciones de nadie. -->
        <dependency>
            <groupId>dev.ginit.corvo</groupId>
            <artifactId>corvo-core</artifactId>
            <version>${corvo.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Los jar que la página ofrece descargar viajan dentro del propio jar del sitio.

                 La alternativa era leerlos del repositorio local de Maven en tiempo de
                 ejecución, y eso ata el sitio a la máquina donde se compiló: en el servidor no
                 hay ~/.m2 y las descargas darían 503 sin que nadie se entere hasta que alguien
                 pulse el botón. Así el despliegue sigue siendo copiar un jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>artefactos-descargables</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/artefactos</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>dev.ginit.corvo</groupId>
                                    <artifactId>corvo-http</artifactId>
                                    <version>${corvo.version}</version>
                                    <type>jar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.ginit.corvo</groupId>
                                    <artifactId>corvo-core</artifactId>
                                    <version>${corvo.version}</version>
                                    <type>jar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.ginit.corvo</groupId>
                                    <artifactId>corvo-view</artifactId>
                                    <version>${corvo.version}</version>
                                    <type>jar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.ginit.corvo</groupId>
                                    <artifactId>corvo-data</artifactId>
                                    <version>${corvo.version}</version>
                                    <type>jar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.ginit.corvo</groupId>
                                    <artifactId>corvo-adapter-servlet</artifactId>
                                    <version>${corvo.version}</version>
                                    <type>jar</type>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.ginit.corvo</groupId>
                                    <artifactId>corvo-launcher</artifactId>
                                    <version>${corvo.version}</version>
                                    <type>jar</type>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
