#!/usr/bin/env bash
# Deja el sitio entero en un jar: `java -jar cero-sitio.jar 8080` y ya está.
#
# Dentro van el frontend compilado, la API, el framework y los jar que la página ofrece
# descargar. Desplegar es copiar un archivo; no hace falta nginx delante para juntar nada ni
# un classpath que mantener a mano en el servidor.
#
# Lo empaqueta cero-launcher, la herramienta del propio framework. Un plugin de terceros aquí
# desmentiría el argumento del proyecto.
set -euo pipefail

AQUI="$(cd "$(dirname "$0")" && pwd)"
FRAMEWORK="${CERO_FRAMEWORK:-$AQUI/../45.Framework_Cero}"
SALIDA="$AQUI/cero-sitio.jar"

azul() { printf '\033[34m%s\033[0m\n' "$*"; }
malo() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

[ -d "$FRAMEWORK/java" ] || {
  malo "no encuentro el framework en $FRAMEWORK"
  malo "dime dónde está:  CERO_FRAMEWORK=/ruta/al/framework ./construir"
  exit 1
}

# El orden importa y no es reversible: Vite escribe dentro de los recursos del backend, así que
# empaquetar primero el backend metería la compilación anterior del front sin avisar a nadie.
azul "1/4 · el front"
(cd "$AQUI/frontend" && npm install --silent && npm run build)

# El paquete que baja el instalador vive en el framework y hay que traerlo. Se hacía a mano, y
# por eso se quedó atrás en una subida de versión: el sitio anunciaba 0.5.0 y servía un 503
# porque el archivo no viajaba dentro del jar. Ahora se copia solo, y si no está se para aquí
# en vez de desplegar un instalador roto.
azul "1.5/4 · el paquete que baja el instalador"
PAQUETE=$(ls "$FRAMEWORK"/java/cero-web/src/main/resources/estaticos/cero-*.tar.gz 2>/dev/null | head -1)
[ -n "$PAQUETE" ] || {
  malo "no encuentro el paquete en el framework."
  malo "ármalo primero:  (cd $FRAMEWORK && ./cero dist)"
  exit 1
}
rm -f "$AQUI"/backend/src/main/resources/instalador/cero-*.tar.gz*
cp "$PAQUETE" "$PAQUETE.sha256" "$AQUI/backend/src/main/resources/instalador/"
printf '   %s · %s\n' "$(basename "$PAQUETE")" "$(du -h "$PAQUETE" | cut -f1)"

azul "2/4 · el framework, instalado en el repositorio local"
(cd "$FRAMEWORK/java" && mvn -q -DskipTests install)

# `clean` y no solo `package`: Maven copia los recursos a target/classes pero no borra los que
# ya no están en las fuentes. Vite renombra su bundle en cada compilación —el hash cambia con el
# contenido—, así que sin limpiar se acumulaba uno por build: 42 archivos, 21 compilaciones, y el
# jar salía con 2,6 MB de bundles muertos que no referencia nadie.
azul "3/4 · el backend"
(cd "$AQUI/backend" \
  && mvn -q -DskipTests clean package \
  && mvn -q dependency:build-classpath -Dmdep.outputFile=target/classpath.txt)

azul "4/4 · un solo jar"
java -cp "$FRAMEWORK/java/cero-launcher/target/classes" cero.launcher.Packager \
     --main dev.ginit.ceroweb.App --out "$SALIDA" \
     "$AQUI/backend/target/classes" \
     $(tr ':' '\n' < "$AQUI/backend/target/classpath.txt")

printf '\n\033[32m%s\033[0m\n' "listo · $(du -h "$SALIDA" | cut -f1) · $SALIDA"
echo "arráncalo con:  java -jar $(basename "$SALIDA") 8080"
